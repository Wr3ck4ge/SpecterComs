{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SpecterComs",
  "version": "1.10.3",
  "identifier": "net.spectercoms.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SpecterComs",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "transparent": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://spectercoms.net https://*.spectercoms.net https://api.fleetyards.net https://storage.fltyrd.net https://cdn.fltyrd.net https://cdn.fleetyards.net; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://spectercoms.net https://*.spectercoms.net wss://spectercoms.net wss://*.spectercoms.net http://localhost:* https://localhost:* ws://localhost:* wss://localhost:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["specter"]
    },
    "updater": {
      "endpoints": [
        "https://spectercoms.net/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0OEU1MDYwQzU2OEREMkEKUldRcTNXakZZRkNPbEduczBqdkFUbU43R0grZGhOdmEvLytmUXJHd0VOQzZXeEM5OWJncWZZaUcK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "ffmpeg-dlls/avcodec-62.dll": "avcodec-62.dll",
      "ffmpeg-dlls/avformat-62.dll": "avformat-62.dll",
      "ffmpeg-dlls/avutil-60.dll": "avutil-60.dll",
      "ffmpeg-dlls/swscale-9.dll": "swscale-9.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
